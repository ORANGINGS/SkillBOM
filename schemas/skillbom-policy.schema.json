{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ORANGINGS/SkillBOM/schemas/skillbom-policy.schema.json",
  "title": "SkillBOM policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema-version": {"const": "2"},
    "version": {"const": "2"},
    "defaults": {"$ref": "#/$defs/defaultRules"},
    "skills": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/skillRules"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "exceptionGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "reason",
        "owner",
        "approved-by",
        "approved-at",
        "expires-at"
      ],
      "properties": {
        "item": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "approved-by": {"type": "string", "minLength": 1},
        "approved-at": {"type": "string", "format": "date"},
        "expires-at": {"type": "string", "format": "date"},
        "ticket": {"type": "string", "minLength": 1}
      }
    },
    "baseProperties": {
      "require-spec-valid": {"type": "boolean"},
      "max-finding-severity": {
        "enum": ["info", "low", "medium", "high", "critical"]
      },
      "denied-capabilities": {"$ref": "#/$defs/stringList"},
      "allowed-services": {"$ref": "#/$defs/stringList"},
      "allowed-agent-tools": {"$ref": "#/$defs/stringList"},
      "exception-expiry-warning-days": {"type": "integer", "minimum": 0},
      "max-exception-days": {"type": "integer", "minimum": 1},
      "require-exception-ticket": {"type": "boolean"},
      "require-separation-of-duties": {"type": "boolean"}
    },
    "defaultRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require-spec-valid": {"type": "boolean"},
        "max-finding-severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "denied-capabilities": {"$ref": "#/$defs/stringList"},
        "allowed-services": {"$ref": "#/$defs/stringList"},
        "allowed-agent-tools": {"$ref": "#/$defs/stringList"},
        "exception-expiry-warning-days": {"type": "integer", "minimum": 0},
        "max-exception-days": {"type": "integer", "minimum": 1},
        "require-exception-ticket": {"type": "boolean"},
        "require-separation-of-duties": {"type": "boolean"}
      }
    },
    "skillRules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require-spec-valid": {"type": "boolean"},
        "max-finding-severity": {
          "enum": ["info", "low", "medium", "high", "critical"]
        },
        "denied-capabilities": {"$ref": "#/$defs/stringList"},
        "allowed-services": {"$ref": "#/$defs/stringList"},
        "allowed-agent-tools": {"$ref": "#/$defs/stringList"},
        "exception-expiry-warning-days": {"type": "integer", "minimum": 0},
        "max-exception-days": {"type": "integer", "minimum": 1},
        "require-exception-ticket": {"type": "boolean"},
        "require-separation-of-duties": {"type": "boolean"},
        "capability-exceptions": {
          "type": "array",
          "items": {"$ref": "#/$defs/exceptionGrant"}
        },
        "service-exceptions": {
          "type": "array",
          "items": {"$ref": "#/$defs/exceptionGrant"}
        },
        "agent-tool-exceptions": {
          "type": "array",
          "items": {"$ref": "#/$defs/exceptionGrant"}
        }
      }
    }
  }
}
